# Copy to .env and fill in. Never commit the real .env.

# --- Required: OpenAI access (tutor chat, quiz grading, classifiers) ---
OPENAI_API_KEY=sk-proj-your-key-here
# ...or, instead of putting the key here, point at an external file that defines it:
# OPENAI_ENV_FILE=/absolute/path/to/openai.env
# Optional: override the tutor/quiz model (defaults to gpt-4o)
# CURRICULUM_CHAT_MODEL=gpt-4o
# CURRICULUM_QUIZ_MODEL=gpt-4o

# --- Who the tutor/quiz prompts address ---
LEARNER_NAME=the learner
LEARNER_PROFILE=a developer new to coding who learns by building real projects; wants short, first-principles explanations.

# --- Optional: weekly-learnings store location (defaults to data/curriculum-weekly.json) ---
# WEEKLY_STORE_PATH=/absolute/path/to/curriculum-weekly.json

# --- Optional integrations (only needed for the crawlers) ---
# WhatsApp-group crawl (crawl-daily.mjs / crawl-wa.mjs): a local WhatsApp daemon
# dir exposing search.js, plus the group JID to crawl.
# WA_DAEMON_DIR=/path/to/whatsapp-daemon
# WA_GROUP_JID=000000000000000000@g.us
# Claude Code session crawl (crawl-sessions.mjs): your projects transcript dir,
# and the source HTML the active-topic list is parsed from.
# CLAUDE_PROJECTS_DIR=/path/to/.claude/projects/<your-project-dir>
# CURRICULUM_HTML_SOURCE=/path/to/curriculum.html
